{
  "name": "ai-3d-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI-first 3D modeling studio: a /studio Claude Code skill drives a headless engine; the browser is a live view.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "studio": "packages/cli/studio.ts"
  },
  "scripts": {
    "build:view": "node apps/view/build.ts",
    "serve": "node packages/cli/studio.ts serve",
    "test": "node --test packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "bench": "node bench/run.ts && node bench/game.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "esbuild": "^0.28.2",
    "manifold-3d": "^3.5.4",
    "quickjs-emscripten": "^0.31.0",
    "three": "^0.187.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}
