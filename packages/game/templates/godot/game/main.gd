extends Node3D
## The game's main scene. Generated by `studio game init` — this file is yours to edit.
## Studio assets arrive in res://assets/studio/ via `studio game import`; never edit those copies
## (fix them in the studio and re-import). This scene builds a floor, light and environment,
## then instances the studio scene so the game starts with whatever you modeled.

const STUDIO_SCENE := "res://assets/studio/scene.glb"

func _ready() -> void:
	_add_environment()
	_add_floor()
	if ResourceLoader.exists(STUDIO_SCENE):
		var studio: Node3D = load(STUDIO_SCENE).instantiate()
		studio.name = "Studio"
		add_child(studio)

func _add_environment() -> void:
	var env := WorldEnvironment.new()
	env.name = "Environment"
	var e := Environment.new()
	e.background_mode = Environment.BG_COLOR
	e.background_color = Color(0.93, 0.92, 0.89)
	e.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	e.ambient_light_color = Color(0.78, 0.78, 0.8)
	e.ambient_light_energy = 0.5
	e.tonemap_mode = Environment.TONE_MAPPER_FILMIC
	env.environment = e
	add_child(env)
	var sun := DirectionalLight3D.new()
	sun.name = "Sun"
	sun.rotation_degrees = Vector3(-52, 38, 0)
	sun.light_energy = 1.0
	sun.shadow_enabled = true
	add_child(sun)

func _add_floor() -> void:
	var body := StaticBody3D.new()
	body.name = "Floor"
	var shape := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = Vector3(60, 0.2, 60)
	shape.shape = box
	shape.position = Vector3(0, -0.1, 0)
	body.add_child(shape)
	var mesh := MeshInstance3D.new()
	var plane := PlaneMesh.new()
	plane.size = Vector2(60, 60)
	var mat := StandardMaterial3D.new()
	mat.albedo_color = Color(0.62, 0.6, 0.57)
	mat.roughness = 0.95
	plane.material = mat
	mesh.mesh = plane
	body.add_child(mesh)
	add_child(body)
