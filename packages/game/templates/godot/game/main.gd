extends Node3D
## The game's main scene. Generated by `studio game init` — this file is yours to edit.
## Studio assets arrive in res://assets/studio/ via `studio game import`; never edit those copies
## (fix them in the studio and re-import). This scene builds a floor, light and environment,
## then instances the studio scene so the game starts with whatever you modeled. Studio characters
## play their idle; if the studio set a player (`studio game import --player <character>`), it stands
## where it stood in the studio and the arrow keys / WASD walk it, with a camera following.

const STUDIO_SCENE := "res://assets/studio/scene.glb"
const CHARS := preload("res://studio/characters.gd")
const PLAYER := preload("res://studio/player.gd")
const EFFECTS := preload("res://studio/effects.gd")
const UI := preload("res://studio/ui.gd")
const LOOK := preload("res://studio/look.gd")
var effects: Node    # effects.set_value("fire", 0.4), effects.event("fed")
var ui: CanvasLayer  # ui.set_bar("heat", 0.4), ui.bubble(node, "Good lad.")
var player: CharacterBody3D
var cam: Camera3D

func _ready() -> void:
	_add_floor()
	if ResourceLoader.exists(STUDIO_SCENE):
		var studio: Node3D = load(STUDIO_SCENE).instantiate()
		studio.name = "Studio"
		add_child(studio)
		CHARS.animate(studio)
	# studio effects and the UI kit's HUD (empty until the studio has some)
	# the studio look (look.json: sky, fog, light, grade); without one, the game's own environment
	if not LOOK.apply(self):
		_add_environment()
	effects = EFFECTS.start(self)
	ui = UI.start(self)
	var info = CHARS.manifest().get("player")
	if info is Dictionary and ResourceLoader.exists("res://assets/studio/player.glb"):
		player = CharacterBody3D.new()
		player.set_script(PLAYER)
		player.name = "Player"
		player.controlled = true
		add_child(player)
		var s: Array = info.get("start", [0, 0, 0])
		player.global_position = Vector3(s[0], 0.05, s[2])
		player.rotation.y = deg_to_rad(float(info.get("rotation", 0.0))) + PI
		cam = Camera3D.new()
		cam.fov = 45.0
		add_child(cam)
		cam.current = true

func _process(delta: float) -> void:
	if player and cam:
		var p := player.global_position
		var want := p + Vector3(0, 2.6, 4.2)
		cam.global_position = cam.global_position.lerp(want, clamp(delta * 3.0, 0.0, 1.0)) if cam.global_position.length() > 0.01 else want
		cam.look_at(p + Vector3(0, 1.0, 0), Vector3.UP)

func _add_environment() -> void:
	var env := WorldEnvironment.new()
	env.name = "Environment"
	var e := Environment.new()
	e.background_mode = Environment.BG_COLOR
	e.background_color = Color(0.93, 0.92, 0.89)
	e.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	e.ambient_light_color = Color(0.78, 0.78, 0.8)
	e.ambient_light_energy = 0.5
	e.tonemap_mode = Environment.TONE_MAPPER_FILMIC
	env.environment = e
	add_child(env)
	var sun := DirectionalLight3D.new()
	sun.name = "Sun"
	sun.rotation_degrees = Vector3(-52, 38, 0)
	sun.light_energy = 1.0
	sun.shadow_enabled = true
	add_child(sun)

func _add_floor() -> void:
	var body := StaticBody3D.new()
	body.name = "Floor"
	var shape := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = Vector3(60, 0.2, 60)
	shape.shape = box
	shape.position = Vector3(0, -0.1, 0)
	body.add_child(shape)
	var mesh := MeshInstance3D.new()
	var plane := PlaneMesh.new()
	plane.size = Vector2(60, 60)
	var mat := StandardMaterial3D.new()
	mat.albedo_color = Color(0.62, 0.6, 0.57)
	mat.roughness = 0.95
	plane.material = mat
	mesh.mesh = plane
	mesh.position.y = -0.006   # a hair below y = 0, so studio ground (a yard, a rug) never flickers against it
	body.add_child(mesh)
	add_child(body)
